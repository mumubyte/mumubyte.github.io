//***自定义变量***//

// 半透明内容底色（--mainBgtransparent）
// 说明：这是旧版主题内置、新版已移除的变量，用于让卡片/正文容器透出底下的网格或背景图。
// 透明度可自行调整（.3 = 30% 不透明，值越小越透）
//
// 网格线颜色（--linesColor）
// 说明：主题本来只在 .theme-vdoing-wrapper 上定义这个变量（见 Page.vue 的 bg-style-1~6），
//      这里补一份到 .theme-mode-* 上只是为了让取值集中在这一个文件里好改。
//      取值与主题保持一致：浅色 rgba(50,0,0,.05)（= 首页 banner 网格同色），深色 rgba(125,125,125,.05)。
//      用它的地方：.vuepress/styles/index.styl 里 .theme-vdoing-wrapper 的网格。

.theme-mode-light
  --mainBgtransparent: rgba(255,255,255,.3)
  --linesColor: rgba(50, 0, 0, .05)

.theme-mode-dark
  --mainBgtransparent: rgba(30,30,34,.3)
  --linesColor: rgba(125, 125, 125, .05)

.theme-mode-read
  --mainBgtransparent: rgba(245,245,213,.3)
  --linesColor: rgba(50, 0, 0, .05)
